{
  "name": "sokan",
  "productName": "Sōkan",
  "description": "Easily organize windows without using a mouse.",
  "version": "2.0.0",
  "author": "Neo Genesis",
  "license": "MIT",
  "main": "index.js",
  "dependencies": {
    "electron-settings": "^4.0.4",
    "koffi": "^2.8.9"
  },
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3"
  },
  "scripts": {
    "start": "set NODE_ENV=development && electron .",
    "clean": "if exist \"dist\" rmdir \"dist\" /q /s",
    "build": "npm run clean && electron-builder",
    "package": "npm run clean && electron-builder --dir"
  },
  "build": {
    "productName": "Sōkan",
    "appId": "com.neogenesis.sokan",
    "copyright": "Copyright © 2025 Neo Genesis.",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "win": {
      "target": {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    },
    "portable": {
      "artifactName": "sokan.exe",
      "requestExecutionLevel": "highest",
      "unpackDirName": "com.neogenesis.sokan"
    }
  }
}
